{
    "name": "@kevinschaich/map",
    "version": "0.1.0",
    "description": "Shared MapLibre map components for Kevin Schaich's projects",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kevinschaich/kevinschaich.git",
        "directory": "packages/map"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        },
        "./map.css": "./src/map.css"
    },
    "files": [
        "dist",
        "src"
    ],
    "sideEffects": [
        "*.css"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "@kevinschaich/components": ">=0.6.0",
        "maplibre-gl": ">=5",
        "react": ">=19",
        "react-dom": ">=19"
    },
    "dependencies": {
        "lucide-react": "^1.63.0",
        "@types/geojson": "^7946.0.16"
    },
    "devDependencies": {
        "@kevinschaich/components": "^0.6.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "maplibre-gl": "^6.16.0",
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "tsup": "^9.0.0",
        "typescript": "5.9.3",
        "vite": "^8.3.5"
    },
    "engines": {
        "node": ">=24"
    }
}

{
    "name": "@kevinschaich/components",
    "version": "0.7.0",
    "description": "Shared branding, components and MapLibre map pieces for Kevin Schaich's projects",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kevinschaich/kevinschaich.git",
        "directory": "packages/components"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./ui/*": {
            "types": "./dist/ui/*.d.ts",
            "default": "./dist/ui/*.js"
        },
        "./map": {
            "types": "./dist/map/index.d.ts",
            "default": "./dist/map/index.js"
        },
        "./map/vite": {
            "types": "./dist/map/vite.d.ts",
            "default": "./dist/map/vite.js"
        },
        "./theme.css": "./src/theme.css",
        "./styles.css": "./src/styles.css",
        "./typeset.css": "./src/typeset.css",
        "./map.css": "./src/map.css",
        "./kit/*": "./dist/kit/*"
    },
    "files": [
        "dist",
        "src"
    ],
    "sideEffects": [
        "*.css",
        "./dist/kit/brand.js"
    ],
    "peerDependencies": {
        "react": ">=19",
        "react-dom": ">=19",
        "maplibre-gl": ">=5"
    },
    "peerDependenciesMeta": {
        "maplibre-gl": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "node scripts/gen-index.mjs && node scripts/sync-tokens.mjs && tsup && node scripts/use-client.mjs",
        "typecheck": "tsc --noEmit",
        "update-typeset": "curl -fsSL https://ui.shadcn.com/typeset.css -o src/typeset.css"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "maplibre-gl": "^6.16.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tailwindcss": "^4.1.0",
        "tsup": "^9.0.0",
        "typescript": "5.9.3",
        "vite": "^8.3.5"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/public-sans": "^5.3.0",
        "@shadcn/react": "^0.3.1",
        "@types/geojson": "^7946.0.16",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "^0.5.0",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.5.0",
        "lucide-react": "^1.63.0",
        "react-day-picker": "^10.0.2",
        "react-resizable-panels": "^4.15.1",
        "recharts": "3.10.1",
        "shadcn": "^4.23.0",
        "shiki": "^4.5.0",
        "tw-animate-css": "^1.4.0"
    },
    "engines": {
        "node": ">=24"
    }
}
